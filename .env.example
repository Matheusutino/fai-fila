# Pode reutilizar as credenciais de fai-elasticsearch/.env (fallback automático).
ELASTICSEARCH_URL=http://localhost:9201
OPENWEBUI_BASE_URL=http://localhost:35000
OPENWEBUI_API_KEY=
OPENWEBUI_MODEL=
DATABASE_URL=sqlite:///var/tasks.db
RABBITMQ_URL=amqp://fai:fai-local@localhost:5673/%2F
STORAGE_DIR=var/uploads
RECEIPT_INDEX=fai-recibos
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
TOP_K=5
MAX_UPLOAD_MB=10
EXTRACTION_TIMEOUT_SECONDS=300
EXTRACTION_MAX_TOKENS=4096
# Opcional para provedores compatíveis com reasoning.effort; vazio omite a opção.
EXTRACTION_REASONING_EFFORT=
# Altere ao mudar a configuração de extração no OpenWebUI para renovar o cache.
OCR_CACHE_VERSION=v1
LEASE_SECONDS=90
MAX_ATTEMPTS=3
# Obrigatória apenas para a rota de indexação após aprovação, nunca no front-end.
INDEX_API_KEY=
# Credenciais locais para o Compose; manter em rede local de demonstração.
RABBITMQ_USER=fai
RABBITMQ_PASSWORD=fai-local
POSTGRES_PASSWORD=fai-local
